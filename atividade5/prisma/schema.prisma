generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id        Int      @id @default(autoincrement())
  name      String
  height    Int
  weight    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
